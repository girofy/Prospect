rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras de Segurança Prospectfy WhatsApp Cloud API & Girofy Comercial
    // Acesso seguro: Apenas requisições autenticadas ou do backend têm permissão

    match /contacts/{phone} {
      allow read, write: if request.auth != null;
    }

    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /data_deletion_requests/{code} {
      allow read: if true; // Permite consulta pública de status com o código de confirmação
      allow write: if request.auth != null;
    }
  }
}
