# ==============================================================================
# PROSPECTFY & GIROFY - VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (VERCEL & NODE.JS)
# ==============================================================================
# NUNCA insira tokens ou senhas reais neste arquivo de exemplo.
# Configure estes valores nas "Environment Variables" da Vercel ou no painel AI Studio.

# ------------------------------------------------------------------------------
# 1. META WHATSAPP CLOUD API (OFICIAL)
# ------------------------------------------------------------------------------
# Token de Acesso do Sistema da Meta (Graph API v21.0)
# Gerado no Meta Business Manager / Meta for Developers para o App "Meuapp"
META_ACCESS_TOKEN="seu_token_permanente_meta_aqui"

# ID do Número de Telefone Comercial (+55 74 8812-6578)
META_PHONE_NUMBER_ID="1221241567748320"

# Chave Secreta do App da Meta (App Secret) para validação X-Hub-Signature-256
META_APP_SECRET="seu_app_secret_da_meta_aqui"

# Token de Verificação do Webhook (Configurado no painel do Webhook na Meta)
META_WEBHOOK_VERIFY_TOKEN="seu_token_de_verificacao_aqui"

# Identificadores da Meta (Referência do Projeto)
META_APP_ID="1572840733789529"
META_BUSINESS_ID="1232106109979142"
AUTHORIZED_BUSINESS_NUMBER="557488126578"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (AGENTE COMERCIAL GIROFY)
# ------------------------------------------------------------------------------
# Chave de API do Google Gemini (utilizada exclusivamente no backend serverless)
GEMINI_API_KEY="sua_chave_gemini_api_aqui"
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 3. APLICAÇÃO & ROTAS PÚBLICAS
# ------------------------------------------------------------------------------
# URL pública da aplicação na Vercel
APP_URL="https://prospectfy.vercel.app"

# ------------------------------------------------------------------------------
# 4. FIREBASE / FIRESTORE (PERSISTÊNCIA REMOTA - OPCIONAL)
# ------------------------------------------------------------------------------
# Se desejar sincronizar diretamente com Firestore remoto via Firebase Admin:
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
